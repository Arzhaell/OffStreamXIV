<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Description>Choose which plugin windows OBS can see, while you keep seeing all of them.</Description>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OffStreamXIV.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icône de la liste des plugins de Dalamud : pour une version de dev, il la lit dans images\ à côté de la DLL. -->
    <None Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
